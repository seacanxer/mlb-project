[Unit]
Description=FC Football Betting Recommendation Engine (fc.texasdrill.me)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/fc.texasdrill.me
Environment="PATH=/var/www/fc.texasdrill.me/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=8000"
Environment="HOST=127.0.0.1"
ExecStart=/var/www/fc.texasdrill.me/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
