# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

ODDS_PROVIDER=""
ODDS_API_KEY=""
ODDS_REGIONS="us"
ODDS_BOOKMAKER=""
# Optional unofficial fallback supplied by the user. Use ODDS_PROVIDER="1xbit".
ODDS_1XBIT_DOMAINS="https://1xbit.com"
BULLPEN_PROVIDER=""
# Optional official MLB active-roster aggregation. Use BULLPEN_PROVIDER="mlb-roster".
DEFAULT_TIMEZONE="Asia/Jakarta"

# Worker configuration
WORKER_SLATE_CRON="0 */3 * * *"
WORKER_RESULTS_CRON="30 */6 * * *"
WORKER_STARTUP_REFRESH="true"
WORKER_LOOKBACK_DAYS="3"

# Optional AI Picker reviewer. Credentials remain server-side.
# Use PICKER_SERVICE_URL when a local picker service already fronts 9Router.
PICKER_SERVICE_URL="http://127.0.0.1:3001/pick"
# Or call an OpenAI-compatible router directly.
NINEROUTER_API_BASE="http://127.0.0.1:20128/v1"
NINEROUTER_API_KEY=""
AI_PICKER_DEFAULT_MODEL="gr/claude-opus-5"
PICKER_SERVICE_TIMEOUT_MS="25000"
AI_ROUTER_TIMEOUT_MS="35000"

# Optional FC Parlay AI reviewer (OpenAI-compatible chat completions).
# The deterministic FC framework remains authoritative when unavailable.
FC_AI_BASE_URL=""
FC_AI_API_KEY=""
FC_AI_MODEL=""
FC_AI_TIMEOUT_SECONDS="30"

# Operator credential for manual FC settlement locks and for the Hasil & ROI
# "Refresh settlement" button (POST /api/fc/settle). Set a long random value
# on the VPS; enter it in the FC watchlist. Never use NEXT_PUBLIC_ prefix.
FC_LOCK_TOKEN=""
# Optional Python path when python3 is not the FC engine interpreter.
FC_PYTHON=""

# FC decision mode (scripts/fc-scan-live.py). Default 'sharp_reference': value
# picks only where the 1xbit price beats the sharp book's no-vig fair price by
# >= 2% (odds 1.50-5.00). Without a reference key the scanner still shows
# forecasts but publishes no value picks. 'model_blend' restores the retired
# v4 goal-model EV (walk-forward replay: -6% to -8% ROI, negative CLV).
FC_DECISION_MODE="sharp_reference"
# The Odds API key used for one bulk request per league per scan
# (markets h2h,totals,spreads = 3 credits per league per scan, region eu).
# Falls back to FC_SECOND_ODDS_API_KEY when empty.
FC_REFERENCE_ODDS_API_KEY=""
FC_REFERENCE_BOOKMAKER="pinnacle"
FC_REFERENCE_REGIONS="eu"
